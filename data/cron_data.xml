<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_cc_overdue_reminders" model="ir.cron">
        <field name="name">Credit Control: Overdue Invoice Reminders</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_cc_overdue_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_cc_pdc_maturity" model="ir.cron">
        <field name="name">PDC: Maturity Alerts</field>
        <field name="model_id" ref="model_cc_pdc"/>
        <field name="state">code</field>
        <field name="code">model._cron_maturity_alerts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
