<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_cc" model="ir.ui.view">
        <field name="name">sale.order.form.credit.control</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="cc_needs_approval" invisible="1"/>
                <button name="action_cc_request_approval" type="object" class="btn-warning"
                        string="Request Credit Approval"
                        invisible="not cc_needs_approval or cc_approval_state == 'requested' or state not in ('draft', 'sent')"/>
                <button name="action_cc_approve" type="object" class="btn-success" string="Approve Credit"
                        invisible="cc_approval_state != 'requested'"
                        groups="credit_pdc_commission.group_cc_manager"/>
                <button name="action_cc_reject" type="object" string="Reject Credit"
                        invisible="cc_approval_state != 'requested'"
                        groups="credit_pdc_commission.group_cc_manager"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="not cc_needs_approval">
                    <field name="cc_credit_message" nolabel="1"/>
                </div>
                <div class="alert alert-info mb-0" role="alert" invisible="cc_approval_state in ('none', False)">
                    Credit approval: <field name="cc_approval_state" readonly="1"/>
                    <span invisible="not cc_approved_by"> by <field name="cc_approved_by" readonly="1"/>
                        (up to <field name="cc_approved_amount" readonly="1"/>)</span>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_cc_credit_approvals" model="ir.actions.act_window">
        <field name="name">Credit Approvals</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('cc_approval_state', '=', 'requested')]</field>
    </record>
</odoo>
