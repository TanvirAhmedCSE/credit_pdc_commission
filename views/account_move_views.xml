<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_view_form_cc" model="ir.ui.view">
        <field name="name">account.move.form.credit.control</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_cc_pdc" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                        invisible="cc_pdc_count == 0" groups="credit_pdc_commission.group_cc_user">
                    <field name="cc_pdc_count" widget="statinfo" string="Cheques"/>
                </button>
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="cc_has_pdc_in_hand" invisible="1"/>
                <field name="cc_bounced_count" invisible="1"/>
                <div class="alert alert-info mb-0" role="alert" invisible="not cc_has_pdc_in_hand">
                    A post-dated cheque for this invoice is in hand and not yet cleared.
                </div>
                <div class="alert alert-danger mb-0" role="alert" invisible="cc_bounced_count == 0 or payment_state == 'paid'">
                    A cheque for this invoice has bounced. The invoice is due again.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
