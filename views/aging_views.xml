<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cc_aging_view_list" model="ir.ui.view">
        <field name="name">cc.aging.report.list</field>
        <field name="model">cc.aging.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="days_overdue &gt; 60" decoration-warning="days_overdue &gt; 0">
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="due_date"/>
                <field name="days_overdue"/>
                <field name="bucket" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="residual" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="cc_aging_view_pivot" model="ir.ui.view">
        <field name="name">cc.aging.report.pivot</field>
        <field name="model">cc.aging.report</field>
        <field name="arch" type="xml">
            <pivot string="Receivable Aging">
                <field name="partner_id" type="row"/>
                <field name="bucket" type="col"/>
                <field name="residual" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="cc_aging_view_graph" model="ir.ui.view">
        <field name="name">cc.aging.report.graph</field>
        <field name="model">cc.aging.report</field>
        <field name="arch" type="xml">
            <graph string="Aging by Bucket" type="bar">
                <field name="bucket"/>
                <field name="residual" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="cc_aging_view_search" model="ir.ui.view">
        <field name="name">cc.aging.report.search</field>
        <field name="model">cc.aging.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="user_id"/>
                <filter name="overdue" string="Overdue" domain="[('days_overdue', '&gt;', 0)]"/>
                <filter name="over_30" string="Over 30 Days" domain="[('days_overdue', '&gt;', 30)]"/>
                <filter name="over_90" string="Over 90 Days" domain="[('days_overdue', '&gt;', 90)]"/>
                <group>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_user" string="Salesperson" context="{'group_by': 'user_id'}"/>
                    <filter name="group_bucket" string="Aging Bucket" context="{'group_by': 'bucket'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cc_aging" model="ir.actions.act_window">
        <field name="name">Aging Analysis</field>
        <field name="res_model">cc.aging.report</field>
        <field name="view_mode">pivot,list,graph</field>
    </record>

    <record id="action_cc_overdue" model="ir.actions.act_window">
        <field name="name">Overdue Receivables</field>
        <field name="res_model">cc.aging.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[('residual', '>', 0)]</field>
        <field name="context">{'search_default_overdue': 1, 'search_default_group_partner': 1}</field>
    </record>
</odoo>
