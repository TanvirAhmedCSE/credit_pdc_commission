<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cc_pdc_bounce_wizard_form" model="ir.ui.view">
        <field name="name">cc.pdc.bounce.wizard.form</field>
        <field name="model">cc.pdc.bounce.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="pdc_id"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="reason" placeholder="e.g. Insufficient funds, signature mismatch"/>
                    <field name="bounce_fee"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Bounce" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
